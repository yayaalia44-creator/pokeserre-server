# Variables à définir dans Render (Environment). Ne jamais mettre les vraies valeurs dans git.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
SECRET_KEY=une_longue_chaine_aleatoire
ADMIN_PASSWORD=un_mot_de_passe_solide
CRON_TOKEN=une_autre_chaine_aleatoire
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Même valeur que "token" dans .claude/hooks/bureau_config.json (page /admin/bureau en direct)
BUREAU_TOKEN=encore_une_chaine_aleatoire
